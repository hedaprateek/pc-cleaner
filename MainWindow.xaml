<Window x:Class="PcCleaner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PC Companion" Width="1380" Height="950" MinWidth="1120" MinHeight="800" Background="#F5F7FB" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17243C"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#E7ECF5"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#315DD9"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="32"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AlternatingRowBackground" Value="#F3F5FA"/><Setter Property="FontWeight" Value="Normal"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
  <Style TargetType="TabItem">
  <Setter Property="Padding" Value="16,14"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="#61708B"/><Setter Property="FontWeight" Value="SemiBold"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavSurface" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}" Margin="0,0,16,0"><ContentPresenter ContentSource="Header" HorizontalAlignment="Left"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#E7EEFF"/><Setter Property="Foreground" Value="#244CBD"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#EDF1F8"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavSurface" Property="BorderBrush" Value="#315DD9"/><Setter TargetName="NavSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#F3F6FB"/><Setter Property="Foreground" Value="#65738C"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="10,10"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="8,0"/></Style>
 <Style TargetType="TextBox"><Setter Property="Padding" Value="9,7"/><Setter Property="BorderBrush" Value="#D5DEEC"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 </Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><StackPanel Orientation="Horizontal"><Border Background="#315DD9" CornerRadius="12" Width="46" Height="46" Margin="0,0,14,0"><TextBlock Text="PC" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="PC Companion" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Understand your PC. Choose what to improve." Foreground="#63718A" Margin="0,3,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="Help / Getting started" Click="ShowGuide_Click" Padding="14,9"/><Border Background="#E6F3EB" CornerRadius="20" Padding="14,8"><TextBlock Text="●  LIVE ON THIS COMPUTER" Foreground="#187047" FontSize="10" FontWeight="SemiBold"/></Border></StackPanel></Grid>
<UniformGrid x:Name="MetricStrip" Grid.Row="1" Columns="4" Margin="0,0,0,20">
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PROCESSOR" FontSize="10" Foreground="#63718A" FontWeight="SemiBold"/><TextBlock x:Name="CpuText" Text="Sampling…" FontSize="26" FontWeight="SemiBold" Margin="0,8"/><ProgressBar x:Name="CpuBar" Height="4" Maximum="100" Foreground="#315DD9"/><TextBlock x:Name="CpuLevel" Text="Waiting for a sample" Margin="0,8,0,0" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="MEMORY IN USE" FontSize="10" Foreground="#63718A" FontWeight="SemiBold"/><TextBlock x:Name="RamText" Text="Loading…" FontSize="19" FontWeight="SemiBold" Margin="0,10"/><ProgressBar x:Name="RamBar" Height="4" Maximum="100" Foreground="#21845D"/><TextBlock x:Name="RamFree" Margin="0,8,0,0" FontSize="11"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="DISK ACTIVITY · ALL DISKS" FontSize="10" Foreground="#63718A" FontWeight="SemiBold"/><TextBlock x:Name="DiskText" Text="Sampling…" FontSize="23" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="DiskDetail" Text="Read / write throughput" FontSize="11" TextWrapping="Wrap" Foreground="#63718A"/><TextBlock x:Name="DiskStatus" Text="Waiting for baseline" FontSize="10" Foreground="#63718A" Margin="0,6,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="SYSTEM DRIVE · FREE" FontSize="10" Foreground="#63718A" FontWeight="SemiBold"/><TextBlock x:Name="StorageText" Text="Loading…" FontSize="26" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="StorageLevel" Text="Checking space" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
</UniformGrid>
<TabControl x:Name="MainTabs" Grid.Row="2" SelectionChanged="MainTabs_Changed" TabStripPlacement="Left" Background="White" BorderThickness="0" Padding="24" SelectedIndex="0"><TabItem Header="Overview" Width="184"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <Border Background="#172D50" CornerRadius="16" Padding="26"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR NEXT USEFUL STEP" Foreground="#AABFE2" FontSize="11" FontWeight="SemiBold"/><TextBlock x:Name="NextActionTitle" Text="Getting to know your PC…" Foreground="White" FontSize="25" FontWeight="SemiBold" Margin="0,10,0,8" TextWrapping="Wrap"/><TextBlock x:Name="NextActionDetail" Text="Live readings will help you choose where to start." Foreground="#D7E3F7" TextWrapping="Wrap" MaxWidth="540" HorizontalAlignment="Left"/></StackPanel><Button Grid.Column="1" x:Name="NextActionButton" Content="Review apps →" Click="NextAction_Click" Background="#C9EADC" Foreground="#173E31" VerticalAlignment="Bottom" Margin="18,0,0,0"/></Grid></Border>
 <TextBlock Text="What would you like to improve?" FontSize="19" FontWeight="SemiBold" Margin="0,25,0,14"/>
 <UniformGrid Columns="3">
 <Border Style="{StaticResource Card}" Background="#F2F6FD"><StackPanel><TextBlock Text="01   FEEL LESS SLOW" FontSize="11" Foreground="#315DD9" FontWeight="SemiBold"/><TextBlock Text="Find busy apps" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="See what is using CPU and memory. Review apps you no longer need." TextWrapping="Wrap" Foreground="#63718A"/><Button Content="Review apps →" Click="ShowApps_Click" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="12,8"/></StackPanel></Border>
 <Border Style="{StaticResource Card}" Background="#F0F8F4"><StackPanel><TextBlock Text="02   MAKE MORE ROOM" FontSize="11" Foreground="#187047" FontWeight="SemiBold"/><TextBlock Text="Explore storage" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Find large folders and files, then decide what is worth keeping." TextWrapping="Wrap" Foreground="#63718A"/><Button Content="Find large files →" Click="ShowStorage_Click" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="12,8"/></StackPanel></Border>
 <Border Style="{StaticResource Card}" Background="#FFF7EB" Margin="0"><StackPanel><TextBlock Text="03   START WITH LESS" FontSize="11" Foreground="#946200" FontWeight="SemiBold"/><TextBlock Text="Review startup" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Choose which apps you need immediately after you sign in." TextWrapping="Wrap" Foreground="#63718A"/><Button Content="Review startup →" Click="ShowStartup_Click" Margin="0,18,0,0" HorizontalAlignment="Left" Padding="12,8"/></StackPanel></Border>
 </UniformGrid>
 <Grid Margin="0,25,0,12"><TextBlock Text="Activity over the last minute" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="LiveUpdated" HorizontalAlignment="Right" Foreground="#63718A" FontSize="12" VerticalAlignment="Center"/></Grid>
 <UniformGrid Columns="3">
 <Border Style="{StaticResource Card}" BorderBrush="#E1E7F0" BorderThickness="1"><StackPanel><TextBlock Text="CPU · 0–100%" FontWeight="SemiBold"/><Canvas x:Name="CpuChart" Height="68" Margin="0,12" ClipToBounds="True" SizeChanged="Chart_SizeChanged"><Polyline x:Name="CpuLine" Stroke="#315DD9" StrokeThickness="2.5"/></Canvas></StackPanel></Border>
 <Border Style="{StaticResource Card}" BorderBrush="#E1E7F0" BorderThickness="1"><StackPanel><TextBlock Text="Memory · 0–100%" FontWeight="SemiBold"/><Canvas x:Name="RamChart" Height="68" Margin="0,12" ClipToBounds="True" SizeChanged="Chart_SizeChanged"><Polyline x:Name="RamLine" Stroke="#21845D" StrokeThickness="2.5"/></Canvas></StackPanel></Border>
 <Border Style="{StaticResource Card}" BorderBrush="#E1E7F0" BorderThickness="1" Margin="0"><StackPanel><TextBlock x:Name="DiskChartScale" Text="Disk throughput · waiting" FontWeight="SemiBold"/><Canvas x:Name="DiskChart" Height="68" Margin="0,12" ClipToBounds="True" SizeChanged="Chart_SizeChanged"><Polyline x:Name="DiskLine" Stroke="#BA7D25" StrokeThickness="2.5"/></Canvas></StackPanel></Border>
 </UniformGrid>
 <TextBlock Text="Disk throughput shows data read and written across physical disks. It does not measure disk saturation. Readings stay in this session." FontSize="12" Foreground="#63718A" TextWrapping="Wrap" Margin="0,10,0,0"/>
 </StackPanel></ScrollViewer></TabItem>
<TabItem Header="Clean up" Width="184"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Scan, review, then clean" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="1  Choose age  →  2  Scan first  →  3  Uncheck files to keep  →  4  Clean results" Foreground="#315DD9" TextWrapping="Wrap" Margin="0,7,0,0"/><TextBlock x:Name="CleanupPolicyText" Text="The default keeps files created or modified within 7 days. Locked and read-only files are skipped. Deleted files cannot be restored by this app." Margin="0,8,0,12" FontSize="12" TextWrapping="Wrap" Foreground="#63718A"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,14"><CheckBox x:Name="UserTemp" Content="Your temporary files" IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,6" Click="Selection_Changed"/><CheckBox x:Name="SystemTemp" Content="Windows temporary files (optional)" VerticalAlignment="Center" Margin="0,0,24,6" Click="Selection_Changed"/><TextBlock Text="Cleanup age:" VerticalAlignment="Center" Margin="0,0,8,6"/><ComboBox x:Name="CleanupAge" Width="230" SelectedIndex="0" SelectionChanged="CleanupAge_Changed" Margin="0,0,0,6"><ComboBoxItem Content="Older than 7 days (default)"/><ComboBoxItem Content="Older than 1 day"/><ComboBoxItem Content="All ages — attempt recent files"/></ComboBox></WrapPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="QuickButton" Content="Quick Clean (no preview)" Click="Quick_Click" ToolTip="Scan and immediately delete eligible files in the selected categories"/><Button x:Name="ScanButton" Content="1. _Scan first" Background="#315DD9" Foreground="White" Click="Scan_Click"/><Button x:Name="CleanButton" Content="2. Review, then _clean" Click="Clean_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="_Cancel" Click="Cancel_Click" IsEnabled="False"/></StackPanel>
    <Expander Grid.Row="3" Header="Search, exclusions and export" IsExpanded="False" Margin="0,0,0,10"><StackPanel Margin="0,0,0,10">
     <WrapPanel Margin="0,0,0,10"><TextBlock Text="Find a path:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PreviewSearch" Width="190" Padding="6" TextChanged="PreviewFilter_Changed" ToolTip="Filter by file or folder path"/><ComboBox x:Name="PreviewFilter" Width="125" Margin="12,0" SelectionChanged="PreviewFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="All entries"/><ComboBoxItem Content="Eligible"/><ComboBoxItem Content="Protected"/><ComboBoxItem Content="Skipped"/><ComboBoxItem Content="Excluded"/><ComboBoxItem Content="Deleted"/></ComboBox><Button x:Name="ExcludeButton" Content="Keep selected files" Click="ExcludeFiles_Click" Padding="12,6"/><Button x:Name="FolderButton" Content="Exclude folder…" Click="ExcludeFolder_Click" Padding="12,6"/><Button x:Name="ClearExclusionsButton" Content="Clear exclusions" Click="ClearExclusions_Click" Padding="12,6"/></WrapPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ExclusionText" Text="No exclusions. Uncheck an eligible file to keep it. Filters only change what is shown." FontSize="12" Foreground="#63718A" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Export preview / results" Click="ExportPreview_Click" Padding="10,4" Margin="8,0,0,0"/></Grid>
    </StackPanel></Expander>
    <DataGrid Grid.Row="4" x:Name="ScanGrid" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Clean" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Uncheck to exclude this file from cleanup"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" IsReadOnly="True"/>
     <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
     <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="130" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="Status" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" IsReadOnly="True"/>
    </DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Tooltip}"/></Style></DataGrid.RowStyle></DataGrid>
    <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="ScanSummary" Text="Scan to see file ages, sizes, and eligibility reasons." TextWrapping="Wrap" Foreground="#63718A"/></StackPanel>
   </Grid></TabItem>
<TabItem Header="Live apps" Width="184"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Which apps are using resources?" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="1  Sort or search  →  2  Select an app  →  3  Save work and close unused apps normally  →  4  Watch the readings. CPU uses two samples; memory may include shared pages, so do not add rows together." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#63718A"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="AppSort" SelectedIndex="0" Width="160" SelectionChanged="AppSort_Changed"><ComboBoxItem Content="Memory usage"/><ComboBoxItem Content="CPU usage"/></ComboBox><TextBlock Text="Find app:" VerticalAlignment="Center" Margin="12,0,0,0"/><TextBox x:Name="AppsSearch" Width="180" Margin="12,0" TextChanged="AppsSearch_Changed" ToolTip="Find a process by name" AutomationProperties.Name="Search processes"/><Button Content="Open Task Manager" Click="TaskManager_Click" Margin="0" Padding="12,6"/></WrapPanel>
    <DataGrid Grid.Row="2" x:Name="AppsGrid" SelectionChanged="AppSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="85"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="110"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="140"/><DataGridTemplateColumn Header="Observation" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Level}" Foreground="{Binding Color}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="3"><TextBlock x:Name="AppsSummary" Text="Sampling processes… The first sample establishes a CPU baseline." TextWrapping="Wrap" Foreground="#63718A" Margin="0,12,0,0"/><TextBlock x:Name="AppSelected" Text="Select a process for guidance. Save your work and close familiar apps normally before using Task Manager." TextWrapping="Wrap" Foreground="#315DD9" Margin="0,10,0,0"/></StackPanel>
   </Grid></TabItem>
<TabItem Header="Storage explorer" Width="184"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><Grid><TextBlock Text="Find where your space goes" FontSize="25" FontWeight="SemiBold"/><Button Content="Storage settings ↗" Click="Storage_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="10,6" FontSize="11" Margin="10,0,0,0"/></Grid><TextBlock Text="1  Choose a folder  →  2  Analyze folder  →  3  Select a result  →  4  Inspect or open in Explorer. Scanning does not delete files." Foreground="#63718A" TextWrapping="Wrap" Margin="0,8,0,12"/></StackPanel>
 <Grid Grid.Row="1" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="StoragePath" IsReadOnly="True"/><Button Grid.Column="1" x:Name="ChooseStorageButton" Content="Choose folder…" Click="ChooseStorage_Click" Margin="10,0,0,0"/></Grid>
 <WrapPanel Grid.Row="2" Margin="0,0,0,16"><Button x:Name="AnalyzeStorageButton" Content="Analyze folder" Click="AnalyzeStorage_Click" Background="#315DD9" Foreground="White"/><Button x:Name="CancelStorageButton" Content="Cancel scan" Click="CancelStorage_Click" IsEnabled="False"/><Button Content="Inspect selected folder" Click="InspectStorageFolder_Click"/><Button Content="Open in Explorer" Click="OpenStorageLocation_Click"/></WrapPanel>
 <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Folders, largest first" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="StorageFolders" Grid.Row="1" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="StorageFolder_Changed"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" Margin="0,0,0,8" Background="#F3F6FB" CornerRadius="10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/><TextBlock Grid.Column="1" Text="{Binding Size}" Foreground="#315DD9" Margin="8,0,0,0"/></Grid><ProgressBar Value="{Binding Share}" Maximum="100" Height="5" Foreground="#5B87DA" Background="#E2E9F5" Margin="0,10,0,7"/><TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#63718A"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
 <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="50 largest files · select to inspect" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/><DataGrid Grid.Row="1" x:Name="LargeFilesGrid" SelectionChanged="LargeFile_Changed"><DataGrid.Columns><DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Path}"/></Style></DataGrid.RowStyle></DataGrid></Grid>
 </Grid>
 <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StorageSummary" Text="Choose Analyze folder to see a breakdown. No files are deleted." TextWrapping="Wrap" Foreground="#315DD9"/><TextBlock x:Name="StorageSelected" Text="Select a folder or file to see its full location." FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#63718A" Margin="0,8,0,0"/><TextBlock Text="Read-only scan · Logical file sizes · Skips and limits make totals partial." ToolTip="Includes local hidden files. Links are skipped; cloud placeholders and hard links can differ from actual disk space. Skips and scan limits make totals partial." FontSize="11" TextWrapping="Wrap" Foreground="#63718A" Margin="0,8,0,0"/></StackPanel>
 </Grid></TabItem>
<TabItem Header="Startup review" Width="184"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="Start your day with fewer distractions" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="1  Review the list  →  2  Open Windows Startup apps  →  3  Turn off optional apps  →  4  Compare at your next sign-in. You can turn apps back on in Windows." Foreground="#63718A" TextWrapping="Wrap" Margin="0,8,0,18"/></StackPanel>
 <Expander Grid.Row="1" Header="How to review startup · three simple steps" IsExpanded="False" Margin="0,0,0,14" Foreground="#315DD9"><Border Background="#F0F5FE" CornerRadius="12" Padding="18" Margin="0,0,0,16"><StackPanel><TextBlock Text="1   Review what you recognize" FontWeight="SemiBold"/><TextBlock Text="Keep security, backup, accessibility and device utilities you rely on. Check unfamiliar entries before changing them." TextWrapping="Wrap" Foreground="#63718A" Margin="20,5,0,12"/><TextBlock Text="2   Turn off optional apps in Windows" FontWeight="SemiBold"/><TextBlock Text="Open Startup apps, find the app, and switch it off if you do not need it at sign-in. Disabling startup does not uninstall it." TextWrapping="Wrap" Foreground="#63718A" Margin="20,5,0,12"/><TextBlock Text="3   Compare at your next sign-in" FontWeight="SemiBold"/><TextBlock Text="Restart when convenient and review how the PC feels. Re-enable an app if you miss its automatic launch." TextWrapping="Wrap" Foreground="#63718A" Margin="20,5,0,0"/></StackPanel></Border></Expander>
 <WrapPanel Grid.Row="2" Margin="0,0,0,14"><Button Content="Open Windows Startup apps →" Click="Startup_Click" Background="#315DD9" Foreground="White"/><Button x:Name="RefreshStartupButton" Content="Refresh list" Click="RefreshStartup_Click"/><TextBlock x:Name="StartupSummary" Text="Reading registered startup entries…" VerticalAlignment="Center" Foreground="#63718A" TextWrapping="Wrap"/></WrapPanel>
 <DataGrid Grid.Row="3" x:Name="StartupGrid" SelectionChanged="StartupEntry_Changed"><DataGrid.Columns><DataGridTextColumn Header="App / entry" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Registered location" Binding="{Binding Source}" Width="180"/><DataGridTextColumn Header="Command / shortcut" Binding="{Binding Command}" Width="2*"/></DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Command}"/></Style></DataGrid.RowStyle></DataGrid>
 <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="StartupSelected" Text="Select an entry to review it. Commands are displayed, never executed." TextWrapping="Wrap" Foreground="#315DD9"/><TextBlock Text="This is a registration inventory, not an enabled-state or startup-impact measurement. Packaged apps, services and scheduled tasks are not included. Windows shows the available on/off controls." FontSize="11" TextWrapping="Wrap" Foreground="#63718A" Margin="0,8,0,0"/></StackPanel>
 </Grid></TabItem>
<TabItem Header="Health insights" Width="184"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel TextElement.FontWeight="Normal">
    <TextBlock Text="Readings with context" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Green: normal · Amber: attention · Red: high · Blue: observing or unavailable. Labels always explain the color." TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#63718A"/>
    <ItemsControl x:Name="InsightsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="10" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{Binding Color}"><Run Text="{Binding Area}"/><Run Text=" · "/><Run Text="{Binding Level}"/></TextBlock><TextBlock Text="{Binding Evidence}" Margin="0,8,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="These are guidance thresholds, not a hardware diagnosis. CPU: 85%+ and RAM: 90%+ for 20 seconds trigger attention. Storage: 10% or 10 GiB remaining triggers attention; 5% or 2 GiB remaining triggers high." FontSize="12" Foreground="#63718A" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,18,0,0"><Button Content="Review resource-heavy apps" Click="ShowApps_Click"/><Button Content="Open Task Manager" Click="TaskManager_Click"/><Button Content="Startup app settings" Click="Startup_Click"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
<TabItem Header="My computer" Width="184"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="DetailsGrid"><DataGrid.Columns><DataGridTextColumn Header="Detail" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
    <DataGrid Grid.Row="1" x:Name="DrivesGrid" Margin="0,14"><DataGrid.Columns><DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="160"/><DataGridTextColumn Header="Available" Binding="{Binding Free}" Width="160"/><DataGridTextColumn Header="Used %" Binding="{Binding UsedPercent, StringFormat=F1}" Width="110"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="RefreshButton" Content="_Refresh details" Click="Refresh_Click"/><Button Content="Copy _details" Click="Copy_Click"/><Button Content="_Export report" Click="Export_Click"/><Button Content="Startup app settings" Click="Startup_Click"/></StackPanel>
   </Grid></TabItem>
<TabItem Header="Cleanup history" Width="184"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Stored on this computer. File sizes may differ from actual disk space recovered." Foreground="#63718A" Margin="0,0,0,14"/><DataGrid Grid.Row="1" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="When" Binding="{Binding When}" Width="*"/><DataGridTextColumn Header="Deleted" Binding="{Binding Deleted}" Width="90"/><DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="90"/><DataGridTextColumn Header="File size cleared" Binding="{Binding Size}" Width="150"/><DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem><TabItem Header="Getting started" Width="184"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Welcome. Start with one useful task." FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
<TextBlock Text="You can look around and scan without making changes. Pick a goal below, follow its steps, and review before acting." Foreground="#63718A" TextWrapping="Wrap" Margin="0,8,0,18"/>
<Border Background="#EAF2FF" CornerRadius="12" Padding="16" Margin="0,0,0,16"><StackPanel><TextBlock Text="Your first visit" FontWeight="SemiBold"/><TextBlock Text="Start with Overview to see current readings. Live counters need a few seconds to settle. Use Health insights for context; temporary-file cleanup helps free space and does not guarantee a faster PC." TextWrapping="Wrap" Foreground="#63718A" Margin="0,6,0,0"/></StackPanel></Border>
<WrapPanel Margin="0,4,0,12"><Button x:Name="GuideOverviewButton" Content="Start with Overview →" Tag="0" Click="GuideTask_Click" Background="#315DD9" Foreground="White"/><CheckBox x:Name="RepeatGuide" Content="Show this guide every time I open the app" VerticalAlignment="Center"/></WrapPanel><UniformGrid Columns="2"><Border Background="#F5F7FB" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12"><StackPanel><TextBlock Text="Free some space" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Keep the default “Older than 7 days” age to start.&#10;2. Click “1. Scan first”. Scanning does not delete files.&#10;3. Review the list. Uncheck files you want to keep.&#10;4. Click “2. Review, then clean” when ready." TextWrapping="Wrap" Margin="0,12,0,10" LineHeight="22"/><TextBlock Text="Deletion is permanent. Quick Clean skips the preview." Foreground="#63718A" FontSize="12" TextWrapping="Wrap"/><Button x:Name="GuideCleanupButton" Content="Open Clean up →" Tag="1" Click="GuideTask_Click" Background="#315DD9" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,9"/></StackPanel></Border><Border Background="#F5F7FB" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12"><StackPanel><TextBlock Text="Understand a slowdown" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Sort by Memory usage or CPU usage.&#10;2. Search or select an app to inspect its readings.&#10;3. Save work and close unused, familiar apps normally.&#10;4. Watch the readings again. Use Task Manager to investigate." TextWrapping="Wrap" Margin="0,12,0,10" LineHeight="22"/><TextBlock Text="A brief spike can be normal. Avoid ending Windows or security processes." Foreground="#63718A" FontSize="12" TextWrapping="Wrap"/><Button x:Name="GuideAppsButton" Content="Open Live apps →" Tag="2" Click="GuideTask_Click" Background="#315DD9" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,9"/></StackPanel></Border><Border Background="#F5F7FB" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12"><StackPanel><TextBlock Text="Find large files" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Choose a folder, or start with your user folder.&#10;2. Click “Analyze folder” and wait for the results.&#10;3. Select a folder or one of the largest files.&#10;4. Inspect the folder or open it in Explorer to review it." TextWrapping="Wrap" Margin="0,12,0,10" LineHeight="22"/><TextBlock Text="This scan measures sizes. It does not delete files." Foreground="#63718A" FontSize="12" TextWrapping="Wrap"/><Button x:Name="GuideStorageButton" Content="Open Storage explorer →" Tag="3" Click="GuideTask_Click" Background="#315DD9" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,9"/></StackPanel></Border><Border Background="#F5F7FB" BorderBrush="#E1E7F0" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,12,12"><StackPanel><TextBlock Text="Review apps at sign-in" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="1. Review the registered entries and the three-step guide.&#10;2. Open Windows Startup apps.&#10;3. Turn off optional apps you do not need at sign-in.&#10;4. Compare at your next sign-in; turn an app back on if needed." TextWrapping="Wrap" Margin="0,12,0,10" LineHeight="22"/><TextBlock Text="Keep security, backup, accessibility and device utilities you rely on." Foreground="#63718A" FontSize="12" TextWrapping="Wrap"/><Button x:Name="GuideStartupButton" Content="Open Startup review →" Tag="4" Click="GuideTask_Click" Background="#315DD9" Foreground="White" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="14,9"/></StackPanel></Border></UniformGrid>

<TextBlock Text="You can reopen these steps from Help / Getting started or the sidebar. My computer has hardware details and report export; Cleanup history lists completed cleanups." FontSize="12" Foreground="#63718A" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem></TabControl>
