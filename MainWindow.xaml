<Window x:Class="PcCleaner.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PC Companion" Width="1240" Height="900" MinWidth="1060" MinHeight="800" Background="#F3F5FA" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Ink" Color="#17243C"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,10"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#E7ECF5"/>
   <Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#315DD9"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="32"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="BorderThickness" Value="0"/><Setter Property="AlternatingRowBackground" Value="#F3F5FA"/><Setter Property="FontWeight" Value="Normal"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,16,0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="18,12"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid><StackPanel><TextBlock Text="PC Companion" FontSize="30" FontWeight="Bold"/><TextBlock Text="A clearer view of your computer. A little more breathing room." Margin="0,6,0,0" Foreground="#63718A"/></StackPanel><Button Content="Windows _storage settings" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Storage_Click"/></Grid>
  <UniformGrid Grid.Row="1" Columns="3" Margin="0,16,0,16">
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="CPU usage" Foreground="#63718A"/><TextBlock x:Name="CpuText" Text="Sampling…" FontSize="28" FontWeight="SemiBold" Margin="0,8"/><ProgressBar x:Name="CpuBar" Height="6" Maximum="100" Foreground="#315DD9"/><TextBlock x:Name="CpuLevel" Text="Waiting for a sample" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
   <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="RAM in use" Foreground="#63718A"/><TextBlock x:Name="RamText" Text="Loading…" FontSize="24" FontWeight="SemiBold" Margin="0,8"/><ProgressBar x:Name="RamBar" Height="6" Maximum="100" Foreground="#315DD9"/><TextBlock x:Name="RamFree" Margin="0,8,0,0" FontSize="12"/></StackPanel></Border>
   <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="System drive · available" Foreground="#63718A"/><TextBlock x:Name="StorageText" Text="Loading…" FontSize="28" FontWeight="SemiBold" Margin="0,8"/><TextBlock x:Name="StorageLevel" Text="Checking available space" FontSize="12" TextWrapping="Wrap"/></StackPanel></Border>
  </UniformGrid>
  <TabControl x:Name="MainTabs" Grid.Row="2" Background="White" BorderThickness="0" Padding="20">
   <TabItem Header="Cleanup"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Keep the useful stuff. Clear old temporary files." FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Only files created and last modified more than 7 days ago are eligible. Files in use are skipped. Deleted files cannot be restored by this app." Margin="0,8,0,12" FontSize="12" TextWrapping="Wrap" Foreground="#63718A"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18"><CheckBox x:Name="UserTemp" Content="Your temporary files" IsChecked="True" VerticalAlignment="Center" Margin="0,0,24,0" Click="Selection_Changed"/><CheckBox x:Name="SystemTemp" Content="Windows temporary files (optional)" VerticalAlignment="Center" Click="Selection_Changed"/></StackPanel>
    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,18"><Button x:Name="QuickButton" Content="_Quick Clean" Background="#315DD9" Foreground="White" Click="Quick_Click" ToolTip="Scan and immediately delete eligible files in the selected categories"/><Button x:Name="ScanButton" Content="_Scan first" Click="Scan_Click"/><Button x:Name="CleanButton" Content="Clean scan _results" Click="Clean_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="_Cancel" Click="Cancel_Click" IsEnabled="False"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,0,0,10">
     <WrapPanel Margin="0,0,0,10"><TextBlock Text="Find a path:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="PreviewSearch" Width="190" Padding="6" TextChanged="PreviewFilter_Changed" ToolTip="Filter by file or folder path"/><ComboBox x:Name="PreviewFilter" Width="125" Margin="12,0" SelectionChanged="PreviewFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="All entries"/><ComboBoxItem Content="Eligible"/><ComboBoxItem Content="Protected"/><ComboBoxItem Content="Skipped"/><ComboBoxItem Content="Excluded"/><ComboBoxItem Content="Deleted"/></ComboBox><Button x:Name="ExcludeButton" Content="Keep selected files" Click="ExcludeFiles_Click" Padding="12,6"/><Button x:Name="FolderButton" Content="Exclude folder…" Click="ExcludeFolder_Click" Padding="12,6"/><Button x:Name="ClearExclusionsButton" Content="Clear exclusions" Click="ClearExclusions_Click" Padding="12,6"/></WrapPanel>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="ExclusionText" Text="No exclusions. Uncheck an eligible file to keep it. Filters only change what is shown." FontSize="12" Foreground="#63718A" TextWrapping="Wrap" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Export preview / results" Click="ExportPreview_Click" Padding="10,4" Margin="8,0,0,0"/></Grid>
    </StackPanel>
    <DataGrid Grid.Row="4" x:Name="ScanGrid" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns>
     <DataGridTemplateColumn Header="Clean" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Uncheck to exclude this file from cleanup"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="2*" IsReadOnly="True"/>
     <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" IsReadOnly="True"/>
     <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="130" IsReadOnly="True"/>
     <DataGridTemplateColumn Header="Status" Width="85"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" Foreground="{Binding Color}" FontWeight="SemiBold" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="2*" IsReadOnly="True"/>
    </DataGrid.Columns><DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Tooltip}"/></Style></DataGrid.RowStyle></DataGrid>
    <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="ScanSummary" Text="Scan to see file ages, sizes, and eligibility reasons." TextWrapping="Wrap" Foreground="#63718A"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Performance insights"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel TextElement.FontWeight="Normal">
    <TextBlock Text="Readings with context" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Green: normal · Amber: attention · Red: high · Blue: observing or unavailable. Labels always explain the color." TextWrapping="Wrap" Margin="0,8,0,16" Foreground="#63718A"/>
    <ItemsControl x:Name="InsightsList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{Binding Background}" CornerRadius="10" Padding="18" Margin="0,0,0,12"><StackPanel><TextBlock FontSize="17" FontWeight="SemiBold" Foreground="{Binding Color}"><Run Text="{Binding Area}"/><Run Text=" · "/><Run Text="{Binding Level}"/></TextBlock><TextBlock Text="{Binding Evidence}" Margin="0,8,0,5" TextWrapping="Wrap"/><TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="These are guidance thresholds, not a hardware diagnosis. CPU: 85%+ and RAM: 90%+ for 20 seconds trigger attention. Storage: 10% or 10 GiB remaining triggers attention; 5% or 2 GiB remaining triggers high." FontSize="12" Foreground="#63718A" TextWrapping="Wrap"/>
    <WrapPanel Margin="0,18,0,0"><Button Content="Review resource-heavy apps" Click="ShowApps_Click"/><Button Content="Open Task Manager" Click="TaskManager_Click"/><Button Content="Startup app settings" Click="Startup_Click"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Apps"><Grid TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Which apps are using resources?" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="CPU is averaged between samples as a share of this computer's total processor capacity. Memory is the working set and can include shared pages; rows should not be added together." TextWrapping="Wrap" Margin="0,8,0,12" Foreground="#63718A"/></StackPanel>
    <WrapPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock Text="Sort by:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="AppSort" SelectedIndex="0" Width="160" SelectionChanged="AppSort_Changed"><ComboBoxItem Content="Memory usage"/><ComboBoxItem Content="CPU usage"/></ComboBox><Button Content="Open Task Manager" Click="TaskManager_Click" Margin="16,0,0,0" Padding="12,6"/></WrapPanel>
    <DataGrid Grid.Row="2" x:Name="AppsGrid"><DataGrid.Columns><DataGridTextColumn Header="Process" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="PID" Binding="{Binding Id}" Width="85"/><DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="110"/><DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="140"/><DataGridTemplateColumn Header="Observation" Width="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Level}" Foreground="{Binding Color}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid>
    <TextBlock Grid.Row="3" x:Name="AppsSummary" Text="Sampling processes… The first sample establishes a CPU baseline." TextWrapping="Wrap" Foreground="#63718A" Margin="0,12,0,0"/>
   </Grid></TabItem>
   <TabItem Header="Computer details"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="140"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DataGrid x:Name="DetailsGrid"><DataGrid.Columns><DataGridTextColumn Header="Detail" Binding="{Binding Name}" Width="200"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/></DataGrid.Columns></DataGrid>
    <DataGrid Grid.Row="1" x:Name="DrivesGrid" Margin="0,14"><DataGrid.Columns><DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="160"/><DataGridTextColumn Header="Available" Binding="{Binding Free}" Width="160"/><DataGridTextColumn Header="Used %" Binding="{Binding UsedPercent, StringFormat=F1}" Width="110"/></DataGrid.Columns></DataGrid>
    <StackPanel Grid.Row="2" Orientation="Horizontal"><Button x:Name="RefreshButton" Content="_Refresh details" Click="Refresh_Click"/><Button Content="Copy _details" Click="Copy_Click"/><Button Content="_Export report" Click="Export_Click"/><Button Content="Startup app settings" Click="Startup_Click"/></StackPanel>
   </Grid></TabItem>
   <TabItem Header="Cleanup history"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Stored on this computer. File sizes may differ from actual disk space recovered." Foreground="#63718A" Margin="0,0,0,14"/><DataGrid Grid.Row="1" x:Name="HistoryGrid"><DataGrid.Columns><DataGridTextColumn Header="When" Binding="{Binding When}" Width="*"/><DataGridTextColumn Header="Deleted" Binding="{Binding Deleted}" Width="90"/><DataGridTextColumn Header="Skipped" Binding="{Binding Skipped}" Width="90"/><DataGridTextColumn Header="File size cleared" Binding="{Binding Size}" Width="150"/><DataGridTextColumn Header="Result" Binding="{Binding Outcome}" Width="130"/></DataGrid.Columns></DataGrid></Grid></TabItem>
  </TabControl>
  <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ProgressBar x:Name="WorkProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed"/><TextBlock Grid.Row="1" x:Name="StatusText" Text="Ready · Your personal files, browser logins, and Recycle Bin are excluded." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#63718A"/></Grid>
 </Grid>
</Window>
